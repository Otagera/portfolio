---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/curriculum.css';

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect('/404');
}

const entry = await getEntry('curricula', slug);

if (!entry) {
	return Astro.redirect('/404');
}

const project = entry.data.project ? await getEntry('projects', entry.data.project) : null;

const { Content } = await entry.render();

const formatDate = (date: Date) => {
	return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
---

<BaseLayout
  title={`${entry.data.title} | Othniel Agera`}
  description={entry.data.summary}
>
  <Header />
  <article class="prose dark:prose-invert prose-teal max-w-none pt-12 transition-colors curriculum-article">
    <div class="mb-12">
      <div class="text-teal-600 dark:text-teal-400 mb-4 transition-colors">$ cat curriculum/{slug}.mdx</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 transition-colors">{entry.data.title}</h1>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-500 font-mono transition-colors mb-4">
        <span>updated {formatDate(entry.data.updatedDate)}</span>
        <span class="text-gray-300 dark:text-gray-800">&bull;</span>
        <span class="text-teal-600 dark:text-teal-500">living document</span>
      </div>
      {project && (
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-[10px] font-bold uppercase tracking-widest not-prose">
          <a href={`/projects/${project.slug}`} class="text-teal-700 dark:text-teal-400 hover:text-teal-600 dark:hover:text-teal-200 transition-colors">
            &larr; back to {project.data.title}
          </a>
        </div>
      )}
    </div>

    <div class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-6 transition-colors">
      <Content />
    </div>

    <div class="mt-20 pt-10 border-t border-gray-200 dark:border-gray-800 transition-colors">
      <a href="/writing" class="text-teal-600 dark:text-teal-400 hover:opacity-80 transition-colors">
        $ cd ../writing
      </a>
    </div>
  </article>
  <Footer />
</BaseLayout>
