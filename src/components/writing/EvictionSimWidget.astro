<div class="writing-widget">
  <div class="panel">
    <div class="prompt-row">
      <span class="sigil">$</span>
      <span class="cmd" id="esw-cmd">comics evict --dry-run</span>
      <span class="cursor"></span>
    </div>
    <div class="stage esw-stage">
      <div class="esw-meter-head">
        <span class="control-label">library volume</span>
        <span class="esw-usage" id="esw-usage"></span>
      </div>
      <div class="esw-meter" id="esw-meter">
        <div class="esw-fill" id="esw-fill"></div>
        <div class="esw-incoming" id="esw-incoming"></div>
        <div class="esw-tick" id="esw-tick"><span>budget</span></div>
      </div>

      <div class="esw-section-label control-label">
        on disk, most evictable first
        <span class="esw-hint">change a book's state, or ★ to pin it</span>
      </div>
      <ol class="esw-list" id="esw-list"></ol>

      <div class="esw-section-label control-label">on Drive only, tap to fetch</div>
      <div class="esw-remote" id="esw-remote"></div>
    </div>
    <div class="log" id="esw-log"></div>
    <div class="playback">
      <div class="transport">
        <button type="button" class="tbtn" id="esw-reset" title="Reset" aria-label="Reset">⟲</button>
        <button type="button" class="chip" id="esw-day">+1 day</button>
      </div>
      <span class="step-readout" id="esw-readout"></span>
    </div>
  </div>
</div>

<style>
  .esw-stage {
    padding-bottom: 18px;
  }
  .esw-meter-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
  }
  .esw-usage {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  :global(.esw-usage b) {
    color: var(--fg);
  }
  :global(.esw-usage .over) {
    color: #ef4444;
  }
  .esw-meter {
    position: relative;
    height: 14px;
    border-radius: 7px;
    background: var(--bg-well);
    border: 1px solid var(--border-faint);
    margin-bottom: 28px;
  }
  .esw-fill,
  .esw-incoming {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 7px;
    transition: width 0.5s ease, left 0.5s ease;
  }
  .esw-fill {
    left: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 55%, transparent), var(--accent));
  }
  .esw-incoming {
    background: repeating-linear-gradient(
      45deg,
      color-mix(in srgb, #f59e0b 70%, transparent) 0 6px,
      color-mix(in srgb, #f59e0b 35%, transparent) 6px 12px
    );
    width: 0;
  }
  .esw-tick {
    position: absolute;
    top: -4px;
    bottom: -4px;
    width: 2px;
    background: var(--fg);
  }
  .esw-tick span {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    color: var(--muted);
    white-space: nowrap;
  }
  .esw-section-label {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    margin: 4px 0 8px;
  }
  .esw-hint {
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.8;
  }
  .esw-list {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(.esw-row) {
    display: grid;
    grid-template-columns: 22px 1fr auto auto;
    grid-template-areas:
      'rank title state pin'
      'rank why   why   why';
    align-items: center;
    column-gap: 10px;
    row-gap: 2px;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-page);
    font-size: 13px;
    transition: opacity 0.4s, border-color 0.2s, background 0.2s;
  }
  :global(.esw-row .rank) {
    grid-area: rank;
    font-size: 11px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  :global(.esw-row .title) {
    grid-area: title;
    font-weight: 700;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.esw-row .size) {
    font-weight: 400;
    color: var(--muted);
    font-size: 11px;
    margin-left: 6px;
  }
  :global(.esw-row .why) {
    grid-area: why;
    font-size: 11px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  :global(.esw-row .why b) {
    color: var(--fg);
  }
  :global(.esw-row .st) {
    grid-area: state;
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 6px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-panel);
    cursor: pointer;
  }
  :global(.esw-row .st:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  :global(.esw-row .st:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }
  :global(.esw-row .pin) {
    grid-area: pin;
    font-size: 13px;
    padding: 2px 7px;
  }
  :global(.esw-row.excluded) {
    opacity: 0.6;
    border-style: dashed;
  }
  :global(.esw-row.doomed) {
    border-color: #ef4444;
    background: color-mix(in srgb, #ef4444 10%, var(--bg-page));
  }
  :global(.esw-row.doomed .title) {
    text-decoration: line-through;
    text-decoration-color: #ef4444;
  }
  :global(.esw-row.new) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  :global(.esw-st-abandoned) { color: #ef4444 !important; }
  :global(.esw-st-finished) { color: #8b5cf6 !important; }
  :global(.esw-st-unread) { color: var(--muted); }
  :global(.esw-st-reading) { color: #10b981 !important; }
  .esw-remote {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  :global(.esw-remote .chip .sz) {
    opacity: 0.6;
    font-weight: 400;
    margin-left: 4px;
  }
  @media (max-width: 480px) {
    :global(.esw-row) {
      grid-template-columns: 18px 1fr auto auto;
      column-gap: 6px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .esw-fill,
    .esw-incoming,
    :global(.esw-row) {
      transition: none;
    }
  }
</style>

<script>
  // Same scoring as comics/src/server/cache/evict.ts, on a pretend shelf.

  type State = 'abandoned' | 'finished' | 'unread' | 'reading';
  interface Book {
    id: string;
    title: string;
    mb: number;
    state: State;
    readDays: number | null; // null = never opened
    fetchedHours: number; // hours since fetched
    pinned: boolean;
  }
  interface Scored {
    book: Book;
    score: number;
    reason: string;
    excluded: string | null;
  }

  const BUDGET_MB = 6000;
  const VOLUME_MB = 7200;
  const MIN_AGE_HOURS = 6;
  const BASE_SCORE: Record<State, number> = { abandoned: 1000, finished: 800, unread: 500, reading: 100 };
  const CYCLE: State[] = ['unread', 'reading', 'finished', 'abandoned'];

  const INITIAL_LOCAL: Book[] = [
    { id: 'lost', title: 'Lost Girls v01', mb: 410, state: 'abandoned', readDays: 90, fetchedHours: 2400, pinned: false },
    { id: 'watch', title: 'Watchmen', mb: 590, state: 'finished', readDays: 40, fetchedHours: 1500, pinned: false },
    { id: 'steel', title: 'The Man of Steel 01-06', mb: 900, state: 'finished', readDays: 3, fetchedHours: 300, pinned: false },
    { id: 'dkr', title: 'The Dark Knight Returns', mb: 1150, state: 'finished', readDays: 200, fetchedHours: 5000, pinned: false },
    { id: 'top10', title: 'Top 10 v01', mb: 450, state: 'unread', readDays: null, fetchedHours: 400, pinned: false },
    { id: 'alias', title: 'Alias v01', mb: 380, state: 'reading', readDays: 1, fetchedHours: 600, pinned: false },
    { id: 'abs', title: 'Absolute Batman v01', mb: 520, state: 'reading', readDays: 25, fetchedHours: 900, pinned: false },
    { id: 'saga', title: 'Saga v01', mb: 300, state: 'finished', readDays: 60, fetchedHours: 3000, pinned: true },
    { id: 'hmu', title: 'History of the Marvel Universe', mb: 700, state: 'unread', readDays: null, fetchedHours: 2, pinned: false },
  ];
  const INITIAL_REMOTE: Book[] = [
    { id: 'kc', title: 'Kingdom Come', mb: 1400, state: 'unread', readDays: null, fetchedHours: 0, pinned: false },
    { id: 'dv', title: 'Batman: Dark Victory', mb: 1100, state: 'unread', readDays: null, fetchedHours: 0, pinned: false },
    { id: 'ba', title: 'Daredevil: Born Again', mb: 800, state: 'unread', readDays: null, fetchedHours: 0, pinned: false },
    { id: 'sand', title: 'The Sandman v01', mb: 650, state: 'unread', readDays: null, fetchedHours: 0, pinned: false },
  ];

  const clone = (b: Book[]) => b.map((x) => ({ ...x }));
  let local = clone(INITIAL_LOCAL);
  let remote = clone(INITIAL_REMOTE);
  let busy = false;
  let doomed = new Set<string>();
  let freshId: string | null = null;
  let incomingMb = 0;
  const logLines: string[] = [];

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const els = {
    cmd: $('esw-cmd'),
    usage: $('esw-usage'),
    fill: $('esw-fill'),
    incoming: $('esw-incoming'),
    tick: $('esw-tick'),
    list: $('esw-list'),
    remote: $('esw-remote'),
    log: $('esw-log'),
    reset: $('esw-reset') as HTMLButtonElement,
    day: $('esw-day') as HTMLButtonElement,
    readout: $('esw-readout'),
  };
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? Math.min(ms, 150) : ms));

  const gb = (mb: number) => (mb / 1000).toFixed(mb >= 10000 ? 0 : 2) + ' GB';
  const used = () => local.reduce((s, b) => s + b.mb, 0);
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  function scoreOf(b: Book): Scored {
    if (b.pinned) return { book: b, score: -Infinity, reason: 'pinned, never evicted', excluded: 'pinned' };
    if (b.fetchedHours < MIN_AGE_HOURS)
      return {
        book: b,
        score: -Infinity,
        reason: `fetched ${b.fetchedHours}h ago, too fresh (min ${MIN_AGE_HOURS}h)`,
        excluded: 'fresh',
      };
    let score = BASE_SCORE[b.state];
    const bits: string[] = [`${b.state} ${BASE_SCORE[b.state]}`];
    if (b.state === 'reading' && b.readDays !== null) {
      const protection = Math.max(0, 90 - b.readDays * 3);
      score -= protection;
      bits.push(`read ${b.readDays}d ago −${protection}`);
    } else if (b.readDays !== null) {
      bits.push(`read ${b.readDays}d ago`);
    } else {
      score += 25;
      bits.push('never opened +25');
    }
    const sizeBonus = Math.min(50, b.mb / 100);
    score += sizeBonus;
    bits.push(`size +${sizeBonus.toFixed(1)}`);
    return { book: b, score: Number(score.toFixed(1)), reason: bits.join(' · '), excluded: null };
  }

  const ranked = () => local.map(scoreOf).sort((a, b) => b.score - a.score);

  function log(line: string) {
    logLines.push(line);
    while (logLines.length > 5) logLines.shift();
    els.log.innerHTML = logLines.map((l) => `<div class="line"><span class="m">&raquo;</span>${l}</div>`).join('');
  }

  function render() {
    const u = used();
    const pct = (mb: number) => Math.min(100, (mb / VOLUME_MB) * 100);
    els.fill.style.width = pct(u) + '%';
    els.incoming.style.left = pct(u) + '%';
    els.incoming.style.width = Math.max(0, pct(u + incomingMb) - pct(u)) + '%';
    els.tick.style.left = pct(BUDGET_MB) + '%';
    const over = u + incomingMb > BUDGET_MB;
    els.usage.innerHTML =
      `<b>${gb(u)}</b>` +
      (incomingMb ? ` + <span class="${over ? 'over' : ''}">${gb(incomingMb)} incoming</span>` : '') +
      ` / budget ${gb(BUDGET_MB)}`;

    els.list.innerHTML = '';
    let rank = 0;
    for (const s of ranked()) {
      const b = s.book;
      const li = document.createElement('li');
      li.className =
        'esw-row' + (s.excluded ? ' excluded' : '') + (doomed.has(b.id) ? ' doomed' : '') + (b.id === freshId ? ' new' : '');
      const rankLabel = s.excluded ? '–' : String(++rank);
      li.innerHTML =
        `<span class="rank">${rankLabel}</span>` +
        `<span class="title">${esc(b.title)}<span class="size">${gb(b.mb)}</span></span>` +
        `<select class="st esw-st-${b.state}" data-act="state" aria-label="Reading state of ${esc(b.title)}">${CYCLE.map(
          (st) => `<option value="${st}"${st === b.state ? ' selected' : ''}>${st}</option>`,
        ).join('')}</select>` +
        `<button type="button" class="chip pin" data-act="pin" aria-pressed="${b.pinned}" title="Pin">${b.pinned ? '★' : '☆'}</button>` +
        `<span class="why">${s.excluded ? esc(s.reason) : `score <b>${s.score}</b> · ${esc(s.reason)}`}</span>`;
      const pinBtn = li.querySelector('button') as HTMLButtonElement;
      const stateSel = li.querySelector('select') as HTMLSelectElement;
      pinBtn.disabled = busy;
      stateSel.disabled = busy;
      pinBtn.addEventListener('click', () => {
        if (busy) return;
        b.pinned = !b.pinned;
        log(`${b.pinned ? 'pinned' : 'unpinned'} ${esc(b.title)}`);
        freshId = null;
        render();
      });
      stateSel.addEventListener('change', () => {
        if (busy) return;
        const next = stateSel.value as State;
        b.state = next;
        if (next === 'unread') b.readDays = null;
        else if (b.readDays === null) b.readDays = 0;
        log(`${esc(b.title)} is now ${next}`);
        freshId = null;
        render();
      });
      els.list.appendChild(li);
    }

    els.remote.innerHTML = '';
    for (const b of remote) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.disabled = busy;
      btn.innerHTML = `${esc(b.title)}<span class="sz">${gb(b.mb)}</span>`;
      btn.addEventListener('click', () => fetchBook(b));
      els.remote.appendChild(btn);
    }
    els.day.disabled = busy;
    els.reset.disabled = busy;
    els.readout.textContent = `${local.length} on disk · ${remote.length} on Drive`;
  }

  async function fetchBook(b: Book) {
    if (busy) return;
    busy = true;
    freshId = null;
    doomed = new Set();
    incomingMb = b.mb;
    els.cmd.textContent = `comics fetch "${b.title}"`;
    render();

    const shortfall = used() + b.mb - BUDGET_MB;
    if (shortfall <= 0) {
      log(`budget check: ${gb(b.mb)} fits, nothing to evict`);
    } else {
      log(`budget check: need ${gb(shortfall)} more room`);
      let freed = 0;
      for (const s of ranked()) {
        if (freed >= shortfall || s.excluded) break;
        doomed.add(s.book.id);
        freed += s.book.mb;
      }
      await wait(500);
      render();
      if (freed < shortfall) {
        log(`<span style="color:#ef4444">can't make room: everything left is pinned or too fresh</span>`);
        await wait(1400);
        doomed = new Set();
        incomingMb = 0;
        busy = false;
        els.cmd.textContent = 'comics evict --dry-run';
        render();
        return;
      }
      const names = local.filter((x) => doomed.has(x.id)).map((x) => esc(x.title));
      log(`evict ${names.join(', ')} (frees ${gb(freed)})`);
      await wait(1300);
      const gone = local.filter((x) => doomed.has(x.id));
      local = local.filter((x) => !doomed.has(x.id));
      // Back on Drive with state intact, like Komga keeping the read history.
      remote = [...remote, ...gone.map((x) => ({ ...x, pinned: false }))];
      doomed = new Set();
      render();
      await wait(300);
    }

    log(`rclone → staging → rename → scan: ${esc(b.title)} is on disk`);
    remote = remote.filter((x) => x.id !== b.id);
    local = [...local, { ...b, fetchedHours: 0 }];
    freshId = b.id;
    incomingMb = 0;
    busy = false;
    els.cmd.textContent = 'comics evict --dry-run';
    render();
  }

  els.day.addEventListener('click', () => {
    for (const b of local) {
      b.fetchedHours += 24;
      if (b.readDays !== null) b.readDays += 1;
    }
    freshId = null;
    log('a day passes: in-progress books lose protection, fresh fetches become fair game');
    render();
  });

  els.reset.addEventListener('click', () => {
    local = clone(INITIAL_LOCAL);
    remote = clone(INITIAL_REMOTE);
    freshId = null;
    doomed = new Set();
    incomingMb = 0;
    logLines.length = 0;
    log('fetch something from Drive to see what makes room');
    render();
  });

  log('fetch something from Drive to see what makes room');
  render();
</script>
